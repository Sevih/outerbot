# Secrets — copier en .env (jamais committé). En prod : secrets SOPS de la stack.
DISCORD_TOKEN=
# Id d'application Discord (enregistrement des slash commands).
CLIENT_ID=

# Guild EvaMains + forum des reviews.
GUILD_ID=1264787916660670605
REVIEW_FORUM_ID=

# Utilisateur admin (commandes /sync, /link, /resync).
ADMIN_USER_ID=104556218491621376

# API interne du site (réseau Docker en prod ; site local en dev).
WIKI_API_URL=http://localhost:3000

# Port de l'API reviews/health (le site pointe BOT_API_URL dessus).
HTTP_PORT=3001

# Chemin de la base SQLite (volume en prod).
DB_PATH=data/outerbot.sqlite

# Salon des annonces (nouveaux coupons + journal du site). Vide = annonces coupées.
ANNOUNCE_CHANNEL_ID=
# Cadence de vérification, en secondes (= délai max entre la sauvegarde et l'annonce).
ANNOUNCE_INTERVAL_SECONDS=60

# /coupon (staff) : rôles autorisés (CSV) et jeton partagé avec la route interne
# du site. Jeton vide = /coupon désactivée.
STAFF_ROLE_IDS=
COUPON_API_SECRET=

# Garde-fous des reviews (défauts raisonnables si absents).
REVIEW_MIN_AGE_DAYS=30
REVIEW_ROLE_IDS=
REVIEW_EMOJI_GUILDS=1264787916660670605,1004791978141171765,781569037078757478
